# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase: create a project, run supabase_schema.sql, then set the public client values.
# These values are public client credentials; enforce access with the SQL RLS policies.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ImgBB uploads images from the browser; VITE_* values are public in the built app.
# Use a dedicated ImgBB key with appropriate account limits; do not reuse a private server credential.
VITE_IMGBB_API_KEY="YOUR_IMGBB_API_KEY"

# Optional fallback image CDN. Never put the Cloudinary API secret in a VITE_* variable.
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="eduhub_unsigned"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
